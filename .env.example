# =====================================================================
# Asterline Research Assistant - Environment Configuration Template
# Copy this file to .env and configure your preferences.
# NEVER commit .env to version control.
# =====================================================================

# LLM Provider Configuration
# Supported options: 'ollama' (default local), 'openai' (hosted), or 'mock' (deterministic fallback for testing)
LLM_PROVIDER=ollama

# Ollama Local Settings (Recommended default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hosted Model Settings (Optional - only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Embeddings & Storage
# Uses sentence-transformers running locally on CPU/GPU
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/asterline.db
CORPUS_PATH=./corpus.jsonl

# LangSmith Observability Configuration (Optional for tracing)
# Set to 'true' once you have configured your LANGCHAIN_API_KEY
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=asterline-research-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
